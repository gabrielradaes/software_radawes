{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:css && npm run build:js",
        "build:css": "tailwindcss -c tailwind.config.cjs -i resources/css/app.css -o public/css/app.css --minify",
        "build:js": "node scripts/copy-vendor-js.mjs",
        "watch:css": "tailwindcss -c tailwind.config.cjs -i resources/css/app.css -o public/css/app.css --watch"
    },
    "devDependencies": {
        "@alpinejs/collapse": "3.14.9",
        "alpinejs": "3.14.9",
        "tailwindcss": "3.4.17"
    }
}
