APP_NAME="RyE"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://__DOMAIN__
FORCE_HTTPS=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/La_Paz

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# ====== CAMBIAR: datos de la base de datos creada en cPanel → MySQL Databases ======
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CAMBIAR_usuario_rye
DB_USERNAME=CAMBIAR_usuario_rye
DB_PASSWORD=CAMBIAR_contrasena
# ===================================================================================

# La sesión vale para radawes.com y todos sus subdominios (panel + tiendas)
SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.__DOMAIN__
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
